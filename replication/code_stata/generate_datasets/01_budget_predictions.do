/************************************/
/**Generate dataset for predictions**/
/************************************/

/*Merge fiscal budgets*/

foreach section in ativo despesa passivo receita {
		forvalues year=2001/2012{
		import excel "${path_dropbox}/data/source/budgets/`section'_`year'.xls", firstrow clear
		gen year=`year'
		cap rename CD_UF id_state
		cap rename CD_MUN id_city
		cap rename CdUF id_state
		cap rename CdMun id_city
		cap rename Populacao2000 Populacao
		keep if id_state!=. & id_city!=.
		save "${path_dropbox}/data/working/`section'_`year'.dta", replace 
		}
	}
	
	foreach section in DespFuncao {
		forvalues year=2004/2012{
		import excel "${path_dropbox}/data/source/budgets/`section'_`year'.xls", firstrow clear
		gen year=`year'
		cap rename CD_UF id_state
		cap rename CD_MUN id_city
		cap rename CdUF id_state
		cap rename CdMun id_city
		cap rename Populacao2000 Populacao
		keep if id_state!=. & id_city!=.
		save "${path_dropbox}/data/working/`section'_`year'.dta", replace 
		}
	}


	foreach section in ativo despesa passivo receita{
	use "${path_dropbox}/data/working/`section'_2001.dta", clear
		forvalues year=2002/2012{
		append using "${path_dropbox}/data/working/`section'_`year'.dta"
		}
	save "${path_dropbox}/data/working/`section'_2001-2012.dta", replace
	}

	foreach section in DespFuncao{
	use "${path_dropbox}/data/working/`section'_2004.dta", clear
		forvalues year=2005/2012{
		append using "${path_dropbox}/data/working/`section'_`year'.dta"
		}
	
	save "${path_dropbox}/data/working/`section'_2004-2012.dta", replace
	}

use "${path_dropbox}/data/working/ativo_2001-2012.dta", clear
	foreach section in despesa passivo receita{
	merge 1:1 id_state id_city year using "${path_dropbox}/data/working/`section'_2001-2012.dta", gen(merge_`section') update
	}
	foreach section in DespFuncao{
	merge 1:1 id_state id_city year using "${path_dropbox}/data/working/`section'_2004-2012.dta", gen(merge_`section') update
	}

drop merge_despesa merge_passivo merge_receita merge_DespFuncao  NOMEDOMUNICIPIOSIAFI Município DespesasporFunção TotalGeraldaDespesaporFunçã MUNICIPIO


gen cod_mun=id_state*10000+id_city


gen term=.
replace term=1997 if year==1997 |year==1998|year==1999|year==2000
replace term=2001 if year==2001 |year==2002|year==2003|year==2004
replace term=2005 if year==2005 |year==2006|year==2007|year==2008
replace term=2009 if year==2009 |year==2010|year==2011|year==2012
	
	
save "${path_dropbox}/data/working/balances_2001-2012.dta", replace


/*Clean/fixed format Brollo et al corruption data*/

use "${path_dropbox}/data/source/corruptiondata_lotteries_brollo.dta", clear

merge m:1 nsorteio using "${path_dropbox}/data/source/info_lotteries.dta", nogen

drop if id_city==.


bys id_city: egen temp1=min(lottery)
bys id_city: egen temp2=max(lottery)

gen temp3=temp1!=temp2 

gen n_lottery=1
replace n_lottery=2 if lottery==temp2 & temp3==1


drop temp*

reshape wide broad narrow fraction_broad fraction_narrow nsorteio year_sorteio month_sorteio day_sorteio year_released month_released day_released lottery date_sorteio date_released, i(id_city term ) j(n_lottery)

gen cod_mun=int(id_city/10)

keep lottery1 broad1 narrow1 fraction_broad1 fraction_narrow1 nsorteio1 date_sorteio1 year_sorteio1 month_sorteio1 day_sorteio1 date_released1 year_released1 month_released1 day_released1 lottery2 broad2 narrow2 fraction_broad2 fraction_narrow2 nsorteio2 date_sorteio2 year_sorteio2 month_sorteio2 day_sorteio2 date_released2 year_released2 month_released2 day_released2 cod_mun term

save "${path_dropbox}/data/working/corruptiondata_lotteries_brollo_reshaped.dta", replace


/*Clean/fixed format Avis et al corruption data*/

use "${path_dropbox}/data/source/corruptiondata_lotteries_avis_source.dta", clear


drop if no_os==.

gen nirregular=exp(lnirregular)
gen falha_total=exp(lfalha_total)
gen mismanagement=exp(lmismanagement)

gen ratio_tot=nirregular/no_os
gen ratio_corr=falha_total/no_os
gen ratio_miss=mismanagement/no_os

xtile q_ratio_tot=ratio_tot, n(4)
xtile q_ratio_corr=ratio_corr, n(4)
xtile q_ratio_miss=ratio_miss, n(4)

gen corr1=q_ratio_corr==4
gen corr2=q_ratio_corr==4 | q_ratio_corr==3

bys cod_mun: egen max_year=max(year)
expand 4
bysort cod_mun: replace year=max_year-4+_n
gen for_prediction2=max_year!=year


keep lfalha_total lnirregular lmismanagement lno_os cod_mun year nirregular no_os falha_total mismanagement ratio_tot ratio_corr ratio_miss q_ratio_tot q_ratio_corr q_ratio_miss corr1 corr2 max_year for_prediction2


save "${path_dropbox}/data/working/corruptiondata_lotteries_avis.dta", replace


/*Merge clean datasets */

use "${path_dropbox}/data/working/balances_2001-2012.dta", clear
merge m:1 cod_mun term using "${path_dropbox}/data/working/corruptiondata_lotteries_brollo_reshaped.dta", nogen
merge m:1 cod_mun using "${path_dropbox}/data/source/demographic_controls.dta", nogen keepusing(income education agriculture industry commerce transport service public_administration employed graduated_people poverty miserable gini_coefficient)
merge m:1 cod_mun year using "${path_dropbox}/data/working/corruptiondata_lotteries_avis.dta", nogen

gen for_prediction=0 if lottery1!=.
replace for_prediction=1 if year<year_sorteio1 & lottery1!=.

drop max_year term
drop if Populacao==.

order lottery1 broad1 narrow1 fraction_broad1 fraction_narrow1 nsorteio1 date_sorteio1 year_sorteio1 month_sorteio1 day_sorteio1 date_released1 year_released1 month_released1 day_released1 lottery2 broad2 narrow2 fraction_broad2 fraction_narrow2 nsorteio2 date_sorteio2 year_sorteio2 month_sorteio2 day_sorteio2 date_released2 year_released2 month_released2 day_released2 id_state id_city year UF Populacao Ativo AtivoFinanceiro Disponivel Caixa Bancos AplicFinanc CreditosCirculAF CredaReceber DepRealizCP OutValorRealiz AtivoNFin RealizCP CreditosCirculANF FornecReceber CreditosParcelados DiversosRespons EmpresteFinanc AdiantamConcedidos Recursosvinculados OutCredCircul ProvisaoDevDuvid BenseValCircul Estoques OutBensValCircul ValoresPendentesCP DespAntecipadas ValoresDiferidos OutValPendCP RealizavelLP DepRealizLP DepCompuls RecursosVincul CredRealizLP DividaAtiva DevedEntidAgente EmprestFinanc CreditosaReceber ProvPerdasProvavLP Permanente Investimentos ParticSocietaria OutInvestimentos ProvPerdasProvavPerm Imobilizado BensMoveisImoveis TitulosValores DeprecAmortEx Diferido DespDiferidas AmortizAcumulada AtivoReal AtivoCompensado RespTituloVal Garantias ConveniosContratos OutCompensac ProvPerdasProvavCP AFValPendenteCP AFaCurtoPrazo AFaLongoPrazo ProvDevDuvFornecimentos EmpresteFinancCP RecursosvinculadosCP TituloseValores ProvPerdasProvavOBV RecursosVinculLP ProvPerdasDividaAtiva EmprestFinancLP CreditosaReceberLP ParticSocEmpDepend TitulosValoresIntangiveis DisponivelMoedaEstrangeira InvestRegimePropPrevid InvestSegmentoRendaFixa InvestSegmentoRendaVariável TítuloseValoresMobiliários InvestTaxadeAdmdoRPPS EmpréstRecurPrevaReceber ProvisãoPerdasemInvest InvestdoRegimePrópPrev InvestemSegmentodeImóveis BensMóveis MáquinaseEquipamentos OutrosBensMóveis BensImóveis EdifícioseInstalações TerraseTerrenos OutrosBensImóveis TítuloseValores BensIntangíveis DisponívelMoedaNacional Títulos FundosdeAplicaçãoFinanceira Poupanças OutrasaplicaçõesFinanceiras DemaisDisponibilidades